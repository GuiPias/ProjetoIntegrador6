e="&lt;b&gt;app-spring-boot · EC2 t3.small (ASG)&lt;/b&gt;&lt;br&gt;Sem IP público · sg-app&lt;br&gt;HTTPS 443, só a partir do sg-alb&lt;br&gt;Java 21 · JAR da Release · cloud-init" style="whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=0;dashed=0;fontSize=10;fontColor=#000;align=left;verticalAlign=middle;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="520" y="418" width="450" height="80" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;app-spring-boot · EC2 t3.small (ASG)&lt;/b&gt;&lt;br&gt;Sem IP público · sg-app&lt;br&gt;HTTPS 443, só a partir do sg-alb&lt;br&gt;Mesmo launch template da zona a" style="whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=0;dashed=0;fontSize=10;fontColor=#000;align=left;verticalAlign=middle;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1075" y="418" width="450" height="80" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;RDS PostgreSQL 16 · primário&lt;/b&gt;&lt;br&gt;db.t3.micro · Multi-AZ · sg-db&lt;br&gt;TCP 5432, só a partir do sg-app&lt;br&gt;Criptografado · backup automático" style="whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=0;dashed=0;fontSize=10;fontColor=#000;align=left;verticalAlign=middle;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="548" y="586" width="425" height="66" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;RDS · réplica standby (outra zona)&lt;/b&gt;&lt;br&gt;Failover automático para o primário&lt;br&gt;Sem acesso direto da aplicação&lt;br&gt;Mesmo grupo de sub-redes de banco" style="whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=0;dashed=0;fontSize=10;fontColor=#000;align=left;verticalAlign=middle;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1103" y="586" width="425" height="66" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;Usuário&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#232F3E;strokeColor=none;strokeWidth=0;dashed=0;fontSize=10;fontColor=#fff;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="235" width="70" height="70" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Usuário final&lt;/b&gt;&lt;br&gt;(navegador)" style="whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=0;dashed=0;fontSize=10;fontColor=#000;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="20" y="308" width="110" height="28" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;Admin&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#232F3E;strokeColor=none;strokeWidth=0;dashed=0;fontSize=10;fontColor=#fff;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="70" height="70" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;Administrador&lt;/b&gt;&lt;br&gt;(IAM + MFA)" style="whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=0;dashed=0;fontSize=10;fontColor=#000;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="10" y="563" width="130" height="28" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;AWS Systems&lt;/b&gt;&lt;br&gt;Manager&lt;br&gt;Session&lt;br&gt;Manager" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#E7157B;strokeColor=none;strokeWidth=1;dashed=0;fontSize=10;fontColor=#fff;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="315" y="470" width="100" height="110" as="geometry"/></mxCell><mxCell id="c54" value="" style="whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=0;dashed=0;fontSize=8;fontColor=#000;align=left;verticalAlign=middle;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1075" y="500" width="160" height="14" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;replicação síncrona entre zonas&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=0;dashed=0;fontSize=9;fontColor=#B85600;align=left;verticalAlign=middle;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="722" y="670" width="300" height="14" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;Portas, rotas e limites de acesso&lt;/b&gt;&lt;br&gt;• Usuário → ALB: TCP 443 (sg-alb aceita 0.0.0.0/0 só nessa porta). ALB → aplicação: TCP 443, só a partir do sg-alb.&lt;br&gt;• Aplicação → banco: TCP 5432, e o sg-db só aceita o sg-app. Não há bastion nem porta 22 aberta: a administração é por Session Manager.&lt;br&gt;• rt-pub: 0.0.0.0/0 → IGW. rt-priv-a e rt-priv-c: 0.0.0.0/0 → NAT da própria zona. rt-db: só rota local (o RDS não precisa de saída).&lt;br&gt;• Fluxo 3 serve também ao agente do Session Manager e aos downloads de instâncias novas do ASG. Cópia entre regiões fica fora do desenho." style="whiteSpace=wrap;html=1;rounded=0;fillColor=#F2F2F2;strokeColor=#999;strokeWidth=1;dashed=0;fontSize=10;fontColor=#000;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="10" y="790" width="1000" height="115" as="geometry"/></mxCell><mxCell id="c57" value="" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;dashed=0;fontSize=10;fontColor=#000;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1020" y="790" width="570" height="115" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;LEGENDA&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=0;dashed=0;fontSize=10;fontColor=#000;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1020" y="795" width="570" height="16" as="geometry"/></mxCell><mxCell id="c59" value="Fluxo 1: usuário → ALB → aplicação (2 zonas) → banco" style="whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=0;dashed=0;fontSize=10;fontColor=#000;align=left;verticalAlign=middle;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1120" y="820" width="460" height="16" as="geometry"/></mxCell><mxCell id="c60" value="Fluxo 2: administrador → Session Manager → instâncias (sem SSH)" style="whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=0;dashed=0;fontSize=10;fontColor=#000;align=left;verticalAlign=middle;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1120" y="840" width="460" height="16" as="geometry"/></mxCell><mxCell id="c61" value="Fluxo 3: sub-rede da aplicação → NAT da própria zona → internet" style="whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=0;dashed=0;fontSize=10;fontColor=#000;align=left;verticalAlign=middle;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1120" y="860" width="460" height="16" as="geometry"/></mxCell><mxCell id="c62" value="Fluxo 4: replicação do banco entre zonas (gerenciada pelo RDS)" style="whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=0;dashed=0;fontSize=10;fontColor=#000;align=left;verticalAlign=middle;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1120" y="880" width="460" height="16" as="geometry"/></mxCell><mxCell id="c63" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#1E9E50;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="536" y="388" as="sourcePoint"/><mxPoint x="668" y="293" as="targetPoint"/><Array as="points"><mxPoint x="668" y="388"/></Array></mxGeometry></mxCell><mxCell id="c64" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#1E9E50;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1091" y="388" as="sourcePoint"/><mxPoint x="1330" y="293" as="targetPoint"/><Array as="points"><mxPoint x="1330" y="388"/></Array></mxGeometry></mxCell><mxCell id="c65" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#1E9E50;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="668" y="237" as="sourcePoint"/><mxPoint x="402" y="240" as="targetPoint"/><Array as="points"><mxPoint x="668" y="160"/><mxPoint x="402" y="160"/></Array></mxGeometry></mxCell><mxCell id="c66" value="" style="edgeStyle=none;html=1;endArrow=none;endFill=1;strokeColor=#1E9E50;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1330" y="237" as="sourcePoint"/><mxPoint x="668" y="160" as="targetPoint"/><Array as="points"><mxPoint x="1330" y="160"/></Array></mxGeometry></mxCell><mxCell id="c67" value="&lt;b&gt;Application Load Balancer · HTTPS 443 · sg-alb&lt;/b&gt;&lt;br&gt;health check: HTTPS /actuator/health a cada 30 s (2 ok = saudável, 3 falhas = fora)" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#8C4FFF;strokeColor=#6B2FD6;strokeWidth=1;dashed=0;fontSize=10;fontColor=#fff;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="470" y="190" width="1050" height="38" as="geometry"/></mxCell><mxCell id="c68" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#1A6BCC;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="270" as="sourcePoint"/><mxPoint x="372" y="270" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c69" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#1A6BCC;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="432" y="262" as="sourcePoint"/><mxPoint x="470" y="209" as="targetPoint"/><Array as="points"><mxPoint x="450" y="262"/><mxPoint x="450" y="209"/></Array></mxGeometry></mxCell><mxCell id="c70" value="" style="edgeStyle=no