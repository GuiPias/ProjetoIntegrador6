="1" parent="1"><mxGeometry x="610" y="315" width="20" height="20" as="geometry"/></mxCell><mxCell id="b2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9933CC;strokeWidth=2;fontColor=#9933CC;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="485" width="20" height="20" as="geometry"/></mxCell><mxCell id="b3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E9E5A;strokeWidth=2;fontColor=#1E9E5A;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1187" y="320" width="20" height="20" as="geometry"/></mxCell><mxCell id="t1" value="JDBC · TCP 5432" style="whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=1;dashed=0;fontSize=8;fontColor=#1F6FD0;align=left;verticalAlign=middle;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="925" y="266" width="110" height="14" as="geometry"/></mxCell><mxCell id="t2" value="SSH · 22" style="whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=1;dashed=0;fontSize=8;fontColor=#9933CC;align=left;verticalAlign=middle;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="822" y="330" width="60" height="14" as="geometry"/></mxCell><mxCell id="t3" value="SSH · 22" style="whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=1;dashed=0;fontSize=8;fontColor=#9933CC;align=left;verticalAlign=middle;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1020" y="474" width="70" height="14" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;Portas, protocolos e limites de acesso&lt;/b&gt;&lt;br&gt;• Usuário → aplicação: TCP 8080 (HTTP) pelo IP elástico; sg-app aceita 0.0.0.0/0 apenas nessa porta.&lt;br&gt;• Administrador → bastion: TCP 22 somente do IP do grupo (/32); bastion → app e banco: TCP 22 com origem sg-bastion.&lt;br&gt;• Aplicação → banco: TCP 5432 liberado só de sg-app para sg-db; banco sem IP público.&lt;br&gt;• Rota pública: 0.0.0.0/0 → Internet Gateway. Rota privada: 0.0.0.0/0 → NAT Gateway (em pub-a) → Internet Gateway.&lt;br&gt;• Zona única e sem HTTPS: limitações registradas na seção de riscos (arquitetura sem alta disponibilidade)." style="whiteSpace=wrap;html=1;rounded=0;fillColor=#F2F2F2;strokeColor=#BBBBBB;strokeWidth=1;dashed=0;fontSize=9;fontColor=#000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="10" y="715" width="830" height="125" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;LEGENDA&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;dashed=0;fontSize=9;fontColor=#000;align=center;verticalAlign=top;spacingLeft=0;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="860" y="715" width="730" height="125" as="geometry"/></mxCell><mxCell id="lg0" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#1F6FD0;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885" y="752" as="sourcePoint"/><mxPoint x="945" y="752" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lt0" value="Fluxo 1: usuário final → aplicação (e aplicação → banco)" style="whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=1;dashed=0;fontSize=9;fontColor=#000;align=left;verticalAlign=middle;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="960" y="744" width="600" height="16" as="geometry"/></mxCell><mxCell id="lg1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#9933CC;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885" y="774" as="sourcePoint"/><mxPoint x="945" y="774" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lt1" value="Fluxo 2: administrador via SSH → bastion → aplicação e banco" style="whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=1;dashed=0;fontSize=9;fontColor=#000;align=lef