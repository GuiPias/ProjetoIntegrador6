# Exemplo de /etc/produtos/produtos.env
# Copie para /etc/produtos/produtos.env, troque TODOS os valores TROCAR_...
# e aplique: chown produtos:produtos produtos.env && chmod 600 produtos.env
# Nunca versione o arquivo real.

DB_HOST=TROCAR_ENDPOINT_DO_POSTGRESQL
DB_PORT=5432
DB_NAME=produtos
DB_USER=TROCAR_USUARIO_DO_BANCO
DB_PASSWORD=TROCAR_SENHA_DO_BANCO

SERVER_PORT=443
SSL_KEYSTORE_PATH=/etc/produtos/keystore.p12
SSL_KEYSTORE_PASSWORD=TROCAR_SENHA_DO_KEYSTORE
