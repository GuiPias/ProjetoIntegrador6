[Unit]
Description=Cadastro de Produtos (Spring Boot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=produtos
Group=produtos
WorkingDirectory=/opt/produtos
EnvironmentFile=/etc/produtos/produtos.env
ExecStart=/usr/bin/java -jar /opt/produtos/produtos.jar
# Permite usar a porta 443 sem rodar como root
AmbientCapabilities=CAP_NET_BIND_SERVICE
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
